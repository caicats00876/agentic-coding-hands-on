{
  "name": "Vibe Coding Environment",
  "features": {
    "ghcr.io/devcontainers-extra/features/aws-cdk:2.0.16": {},
    "ghcr.io/devcontainers/features/aws-cli:1.1.2": {},
    "ghcr.io/devcontainers/features/node:1.6.3": {}
  },
  "postCreateCommand": {
    "Install Extra Apt Packages": "sudo apt -y update"
  },
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": ["saoudrizwan.claude-dev", "amazonwebservices.aws-toolkit-vscode"]
    }
  },
  "containerEnv": {
    "AWS_DEFAULT_REGION": "us-west-2"
  },
  "remoteUser": "codespace"
}
