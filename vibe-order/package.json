{
	"name": "vibe-order",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/shared",
		"packages/backend",
		"packages/frontend"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "npm run build -w @vibe-order/shared && vitest --run",
		"coverage": "npm run build -w @vibe-order/shared && vitest --run --coverage",
		"build": "npm run build --workspaces --if-present",
		"test:e2e": "npm run test:e2e -w @vibe-order/frontend",
		"prepare": "cd .. && husky vibe-order/.husky"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.4",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"typescript": "7.0.2",
		"vitest": "5.0.4"
	}
}
