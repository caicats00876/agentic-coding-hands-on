{
	"name": "vibe-order",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/shared",
		"packages/backend",
		"packages/frontend"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "npm run build -w @vibe-order/shared && vitest --run",
		"build": "npm run build --workspaces --if-present"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "24.19.2",
		"typescript": "7.0.2",
		"vitest": "5.0.4"
	}
}
